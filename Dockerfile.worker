FROM node:24-bookworm-slim AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --global npm@11.11.0 && npm ci --ignore-scripts

COPY tsconfig.json ./
COPY scripts/build-worker.mjs scripts/run-diana-worker.ts ./scripts/
COPY lib ./lib
RUN npm run worker:build

FROM node:24-bookworm-slim AS worker

WORKDIR /app

ENV NODE_ENV=production

COPY --from=deps --chown=node:node /app/dist/worker/run-diana-worker.cjs ./dist/worker/run-diana-worker.cjs

USER node

CMD ["node", "dist/worker/run-diana-worker.cjs", "--poll-ms=1000"]
