    "beta:report": "tsx scripts/beta/report.ts",
    "beta:cleanup": "tsx scripts/beta/cleanup.ts",
    "beta:finalize": "tsx scripts/beta/finalize.ts",
    "specialist:assets": "node scripts/sync-specialist-runtime-assets.mjs",
