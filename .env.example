# Diana environment contract
# Keep this file secret-free. Use .env.local for local Next.js development,
# Vercel environment variables for the web app, and Supabase secrets for Edge
# Functions. Variables marked REQUIRED are checked by /api/readiness.

# Core web runtime (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional canonical site origin. Used by integrations that construct callback
# URLs; set it to the same public origin as NEXT_PUBLIC_APP_URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server operations. CRON_SECRET authenticates every cron route. Generate a
# high-entropy value and never expose it through a NEXT_PUBLIC_ variable.
CRON_SECRET=

# Portfolio upload receipts (REQUIRED in production). Use a dedicated random
# value of at least 32 characters. The app never falls back to a Supabase key.
PORTFOLIO_UPLOAD_SIGNING_SECRET=

# Web push. Configure all three values together to enable push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@diana.app

# Parent digest email. Both values are required to enable delivery.
RESEND_API_KEY=
RESEND_FROM=

# LMS OAuth. Configure each provider as a complete pair.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Exact HTTPS origins, or use CANVAS_INSTITUTIONS_JSON for an institution map.
CANVAS_ALLOWED_ORIGINS=
CANVAS_INSTITUTIONS_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Provider canary. Mock mode is credential-free and intercepts all network calls.
# Staging mode performs real writes only when every DIANA_CANARY_* value below is
# present and DIANA_PROVIDER_CANARY_ALLOW_WRITES equals true. Use disposable work.
DIANA_PROVIDER_CANARY_MODE=mock
DIANA_PROVIDER_CANARY_ALLOW_WRITES=false
DIANA_CANARY_PREVIEW_ORIGIN=
DIANA_CANARY_CANVAS_BASE_URL=
DIANA_CANARY_CANVAS_INSTITUTION_ID=
DIANA_CANARY_CANVAS_ACCESS_TOKEN=
DIANA_CANARY_CANVAS_REFRESH_TOKEN=
DIANA_CANARY_CANVAS_CLIENT_ID=
DIANA_CANARY_CANVAS_CLIENT_SECRET=
DIANA_CANARY_CANVAS_COURSE_ID=
DIANA_CANARY_CANVAS_TEXT_ASSIGNMENT_ID=
DIANA_CANARY_CANVAS_FILE_ASSIGNMENT_ID=
DIANA_CANARY_GOOGLE_ACCESS_TOKEN=
DIANA_CANARY_GOOGLE_REFRESH_TOKEN=
DIANA_CANARY_GOOGLE_CLIENT_ID=
DIANA_CANARY_GOOGLE_CLIENT_SECRET=
DIANA_CANARY_GOOGLE_GRANTED_SCOPES=
DIANA_CANARY_GOOGLE_COURSE_ID=
DIANA_CANARY_GOOGLE_FILE_COURSEWORK_ID=

# Canva OAuth. CANVA_REDIRECT_URI is optional when NEXT_PUBLIC_SITE_URL is set.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# Optional app features
LANGUAGETOOL_URL=
DIANA_LANDING_EDITOR_EMAILS=

# Worker API and queue routing. Keep inline mode unless the managed worker
# deployment and bearer token are configured. Tenant lists are comma-separated.
WORKER_API_TOKEN=
DIANA_VOICE_QUEUE_MODE=inline
DIANA_VOICE_MANAGED_QUEUE_TENANTS=
DIANA_VOICE_INLINE_QUEUE_TENANTS=
DIANA_OPENJARVIS_SIDECAR_ENABLED=false
# Legacy alias accepted by the app; prefer DIANA_OPENJARVIS_SIDECAR_ENABLED.
DIANA_VOICE_SIDECAR_ENABLED=
OPENJARVIS_BASE_URL=http://127.0.0.1:8000
OPENJARVIS_MODEL=llama3.2:3b

# Release identity. Vercel supplies VERCEL_GIT_COMMIT_SHA automatically;
# DIANA_APP_BUILD_SHA overrides it for non-Vercel worker deployments.
DIANA_APP_BUILD_SHA=
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# Standalone worker and deployment verification tools (not web runtime)
DIANA_WORKER_BASE_URL=http://127.0.0.1:3000
DIANA_WORKER_ID=
DIANA_WORKER_IMAGE_SHA=
DIANA_WORKER_QUEUE=student-ai-candidate
DIANA_WORKER_SMOKE_QUEUE=
DIANA_WORKER_CANARY_OWNER_ID=
DIANA_WORKER_EXPECTED_IMAGE_SHA=
DIANA_EXPECTED_APP_SHA=
SUPABASE_PROJECT_REF=
# Set only in staging/release automation that has a Supabase access token.
DIANA_VERIFY_EDGE_FUNCTION_PARITY=false

# Local AI and command-center tooling (not production web dependencies)
DIANA_LOCAL_AI_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
PAPERCLIP_API_URL=http://127.0.0.1:3100
GSTACK_ROOT=

# Desktop shell
PORT=3000
DIANA_ELECTRON_URL=http://localhost:3000

# Browser and visual QA only. QA_CREATE_USER is blocked in production. Prefer
# an already-onboarded test account for checks against a deployed environment.
QA_BASE_URL=http://localhost:3000
QA_RUN_NAME=
QA_USER_EMAIL=
QA_USER_PASSWORD=
QA_CREATE_USER=false
QA_TEST_EMAIL=
QA_TEST_PASSWORD=
QA_GRAYSON_TEST_EMAIL=
QA_ONBOARDING_TEST_EMAIL=
QA_SCREEN_DESIGN_PRIMARY_EMAIL=
QA_SCREEN_DESIGN_SECONDARY_EMAIL=
QA_SCREEN_DESIGN_PUBLIC_EMAIL=

# ScreenDesign capture and release tooling only
SCREEN_IDS=
SCREENDESIGN_REVIEW_DIR=
SCREENDESIGN_REVIEW_RUN_ID=
SCREENDESIGN_REVIEW_RELEASE_SHA=
VERCEL_INSPECTION_SHA=

# Supabase Edge Function secrets. Set with `supabase secrets set`; do not add
# these values to the Next.js or Vercel environment unless listed above.
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically by Supabase hosted functions.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
STUDENT_AI_PROVIDER=openai
STUDENT_AI_OPENAI_MODEL=
STUDENT_AI_OPENAI_FAST_MODEL=
STUDENT_AI_OPENAI_QUALITY_MODEL=
STUDENT_AI_OPENAI_COMPLEX_MODEL=
# Comma-separated web origins allowed to call authenticated Edge Functions.
# Production Edge Functions intentionally fail closed when this is unset.
DIANA_ALLOWED_ORIGINS=https://app.example.com
# Optional preview support. This does not replace DIANA_ALLOWED_ORIGINS and the
# shared CORS policy accepts only HTTPS diana-<deployment> origins ending in
# this exact team/project suffix. Bare .vercel.app is rejected.
DIANA_ALLOWED_PREVIEW_HOST_SUFFIX=-teamcarrillo405-hubs-projects.vercel.app

# Backward-compatible public key alias used only by older TTS clients. New
# deployments should leave this blank and use the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
